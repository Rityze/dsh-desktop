# Python bytecode from release-note scripts / tests
__pycache__/
*.pyc

# Native recovery UI smoke-test output
/artifacts/recovery-ui/

# Local-only design docs
docs/plugin-management.zh.md
docs/default-capabilities.zh.md
docs/mobile-connection-latency.zh.md

# Local pnpm content store
/.pnpm-store/
/.build/
/packages/ppt-runtime/templates/
/packages/ppt-bundles/

# The market plugins are shipped as installed, node_modules and all — they are
# compiled npm packages rather than source, and a lock file cannot reproduce a
# generation directory. See market-plugins/README.md.
!market-plugins/

# Built bundles inside our own packages. The market plugins keep theirs — those
# files ship inside the tarball and dropping them would make the copy not the
# package — but anything this repository builds is reproducible from its source.
/packages/*/client/client.js
/packages/*/client/client.js.map
/packages/*/lib/*.js.map
