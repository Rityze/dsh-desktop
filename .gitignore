node_modules/
out/
dist/
dist-dev/
.DS_Store
*.log
coverage/
/doc/
/deliverables/
build/icon.iconset/
build/app-icon.iconset/
build/icon-1024.png
.env
.env.*
!.env.example
.coaligne/
